FROM lscr.io/linuxserver/webtop:ubuntu-xfce

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
        libxi6 at-spi2-core ca-certificates curl socat tar \
    && rm -rf /var/lib/apt/lists/*

# Install as root into an image-owned path. Not /config: that is the runtime
# volume, and not writable by an unmapped build-time UID.
ARG CUA_DRIVER_RS_VERSION=
ENV CUA_DRIVER_ROOT=/opt/cua

RUN mkdir -p "${CUA_DRIVER_ROOT}" \
    && curl -fsSL https://cua.ai/driver/install.sh -o /tmp/install-cua-driver.sh \
    && HOME="${CUA_DRIVER_ROOT}" bash /tmp/install-cua-driver.sh \
    && rm /tmp/install-cua-driver.sh \
    && ln -sf "${CUA_DRIVER_ROOT}/.local/bin/cua-driver" /usr/local/bin/cua-driver \
    && chmod -R a+rX "${CUA_DRIVER_ROOT}"

# Assertions run as root but check the artifact, not the build identity —
# PUID/PGID are meaningless until the runtime remap has happened.
RUN cua-driver --version \
    && test "$(command -v socat)" = /usr/bin/socat

COPY cua-driver-run /etc/s6-overlay/s6-rc.d/svc-cua-driver/run
RUN chmod +x /etc/s6-overlay/s6-rc.d/svc-cua-driver/run \
    && printf 'longrun' > /etc/s6-overlay/s6-rc.d/svc-cua-driver/type \
    && mkdir -p /etc/s6-overlay/s6-rc.d/svc-cua-driver/dependencies.d \
        /etc/s6-overlay/s6-rc.d/user/contents.d \
    && touch /etc/s6-overlay/s6-rc.d/svc-cua-driver/dependencies.d/svc-de \
    && touch /etc/s6-overlay/s6-rc.d/user/contents.d/svc-cua-driver
