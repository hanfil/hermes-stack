# ---------------------------------------------------------------------------
# hermes-stack environment — TEMPLATE
#
#   cp .env.example .env && chmod 600 .env
#
# Then fill in every REQUIRED value. Nothing here is a real credential; every
# value below is a placeholder or a generator command.
#
# .env is gitignored. Keep it that way — it holds full control of the stack.
# ---------------------------------------------------------------------------


# === Host identity =========================================================
# The container's internal user (uid 1024) is remapped to these at boot so
# files written into the bind mounts stay owned by YOU on the host, not root.
# Get them with: id -u ; id -g
# Wrong values here are the #1 cause of "Permission denied" on first boot.
UID=1000
GID=1000


# === Bind-mount paths (absolute, on the host) ==============================
# Create all four as your own user BEFORE the first `up`, or Docker creates
# them root-owned and the container cannot write to them:
#   mkdir -p hermes-home workspace wiki acp-ipc
#   chmod 700 acp-ipc
#
# MCU_HERMES_HOME — every profile's config, session DB, memory, credentials.
#                   This is the stack's persistent state. Back it up.
MCU_HERMES_HOME=/absolute/path/to/hermes-stack/hermes-home
# MCU_WORKSPACE   — where the agents' git checkouts live. Mounted at
#                   /workspace in BOTH containers, at the same path (ACP
#                   requires identical paths on both sides).
MCU_WORKSPACE=/absolute/path/to/hermes-stack/workspace
# MCU_WIKI        — Obsidian knowledge base, mounted at /wiki in both.
MCU_WIKI=/absolute/path/to/hermes-stack/wiki
# MCU_ACP_IPC     — holds one Unix socket per profile for the ACP bridge
#                   between the IDE and the agents. Mode 700, never 777.
MCU_ACP_IPC=/absolute/path/to/hermes-stack/acp-ipc


# === Hermes WebUI (port 8787) ==============================================
# REQUIRED. Login password for the web interface, which the Cloudflare tunnel
# fronts. This is the only thing between the public internet and an agent
# with a terminal — make it long.
#   Generate: openssl rand -base64 24
HERMES_WEBUI_PASSWORD=replace-me-with-a-long-random-password


# === Dashboard backend (port 9119) — needed for Hermes Desktop =============
# REQUIRED if you want to attach Hermes Desktop as a Remote gateway and create
# Bots from the app (see README "Creating the bots").
#
# The backend binds 0.0.0.0 inside the container so Docker can forward the
# port; a non-loopback bind ALWAYS engages the auth gate, so these are not
# optional decoration — without them the backend refuses to serve.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=replace-me-with-a-long-random-password
# Stable signing secret. WITHOUT IT a new random key is generated on every
# boot and Desktop is logged out after each restart.
#   Generate: openssl rand -base64 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=replace-me-with-a-random-32-byte-secret


# === Browser IDE (openvscode-server, port 8080) ============================
# REQUIRED. openvscode-server with NO token is completely unauthenticated, and
# this instance exposes a shell, a GitHub token with push rights, and five
# agents with terminal access. The entrypoint refuses to start without it
# (exit 78) rather than come up wide open.
#
# CHARSET IS ENFORCED by openvscode-server: 0-9, a-z, A-Z and hyphen ONLY.
# A password containing spaces or dots will be REJECTED at startup.
#   Generate: openssl rand -hex 16
MCU_IDE_TOKEN=replace-me-with-32-hex-characters

# OPTIONAL, default 0. Set to 1 for ONE boot to force ide/settings.json and
# ide/mcu.code-workspace back over the live copies in the container's volume:
#   IDE_RESEED_SETTINGS=1 docker compose up -d --force-recreate vscode-ide
# A timestamped .bak of the replaced file is kept. Leave at 0 normally so an
# ordinary restart never clobbers settings you changed in the IDE UI.
IDE_RESEED_SETTINGS=0


# === Cloudflare tunnel =====================================================
# OPTIONAL — omit the `cloudflared` service entirely for a LAN-only install.
# Token-based tunnel: ingress hostnames are configured in the Cloudflare
# dashboard, not here. The tunnel reaches the other containers by service
# name over the internal network (e.g. http://vscode-ide:3000), so no extra
# host ports are needed.
#
# PUT A CLOUDFLARE ACCESS POLICY IN FRONT OF ANY HOSTNAME YOU PUBLISH.
# The WebUI password and IDE token have no rate limiting, no lockout and no
# MFA; Access is what adds those.
CLOUDFLARE_TUNNEL_TOKEN=replace-me-with-your-cloudflare-tunnel-token


# === LLM provider ==========================================================
# OPTIONAL. Only needed if you point Hermes at a custom OpenAI-compatible
# endpoint (this deployment uses a self-hosted Qwen). Omit when the agents
# authenticate through an Anthropic/OpenAI subscription instead.
HERMES_CUSTOM_BAMSE_API_KEY=replace-me-or-delete-this-line


# === Gateways / ACP sockets ================================================
# Which profiles get a gateway AND an ACP socket. Space-separated.
#
# ON A FIRST DEPLOY, LEAVE THIS EMPTY. The profiles do not exist yet, and
# `hermes gateway run` refuses an unknown profile:
#     Error: Profile 'tony-stark' does not exist.
# The supervisor would retry each one forever with exponential backoff.
#
# Create the bots in Hermes Desktop (README Phase 6), then list them here and
# `docker compose up -d --force-recreate hermes-mcu-core` (README Phase 7).
#
# Empty string  = start no gateways (valid; logged explicitly)
# Commented out = fall back to the five-persona default in start-mcu.bash
MCU_GATEWAY_PROFILES=""

# Seconds between gateway starts, to avoid a thundering herd at boot.
MCU_GATEWAY_STAGGER_S=8


# === Optional overrides (not in .env by default) ===========================
# Uncomment only if you need to change the defaults baked into start-mcu.bash.
#
# How long the supervisor waits for the runtime-created venv before giving up.
#   default: 600
# MCU_DASHBOARD_WAIT_S=600
